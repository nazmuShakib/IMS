		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"test": "vitest run",
		"lint": "eslint",
		"typecheck": "tsc --noEmit",
		"seed": "tsx scripts/seed.ts",
		"auth:bootstrap": "dotenv -e .env.local -- tsx scripts/bootstrap-admin.ts",
