		"@prisma/client": "^6.1.0",
		"@react-pdf/renderer": "^4.5.1",
		"@tailwindcss/postcss": "^4.3.2",
		"better-auth": "^1.6.23",
		"cmdk": "^1.0.4",
		"date-fns": "^4.1.0",
		"date-fns-tz": "^3.2.0",
		"lucide-react": "^0.468.0",
		"next": "^16.2.10",
		"papaparse": "^5.4.1",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-hook-form": "^7.54.0",
