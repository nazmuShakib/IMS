# Phase 0 = "json"  |  Phase 1 = "postgres"
DATA_SOURCE="json"

# --- Phase 1 only (Neon) ---
# POOLED connection (host contains "-pooler"). Used at runtime.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DIRECT connection (no "-pooler"). Required by `prisma migrate` — it cannot run through PgBouncer.
DIRECT_DATABASE_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

BETTER_AUTH_SECRET="generate with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"
