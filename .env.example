# Inventory backend: PostgreSQL from Phase 6. Use "json" only for legacy local data.
DATA_SOURCE="postgres"

# --- Neon: required from Phase 3 for Better Auth and audit logs ---
# POOLED connection (host contains "-pooler"). Used at runtime.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DIRECT connection (no "-pooler"). Required by `prisma migrate` — it cannot run through PgBouncer.
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

BETTER_AUTH_SECRET="generate with: openssl rand -base64 32"
# Local: http://localhost:3000
# Vercel production: the exact canonical HTTPS URL, for example
# https://your-project.vercel.app. Do not use a preview URL here.
BETTER_AUTH_URL="http://localhost:3000"

# Printed on stock labels. Defaults to "Electronics Shop" when omitted.
SHOP_NAME="Electronics Shop"
# Optional invoice header and footer details.
SHOP_ADDRESS=""
SHOP_PHONE=""
INVOICE_POLICY=""

# One-time bootstrap: npm run auth:bootstrap
INITIAL_ADMIN_NAME="Shop Owner"
INITIAL_ADMIN_PHONE="01712345678"
INITIAL_ADMIN_PASSWORD="replace-with-at-least-12-characters"
